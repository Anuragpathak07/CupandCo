{
  "expo": {
    "name": "Cup & Co",
    "slug": "cupandco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cupandco",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cupandco.operations",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cupandco.operations",
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "name": "Cup & Co Operations",
      "shortName": "Cup & Co",
      "description": "Fast, calm café order operations.",
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "manifest": {
        "name": "Cup & Co Operations",
        "short_name": "Cup & Co",
        "description": "Fast, calm café order operations.",
        "start_url": "/",
        "display": "standalone",
        "background_color": "#F8F5EE",
        "theme_color": "#C5A059",
        "orientation": "portrait-primary",
        "scope": "/",
        "icons": [
          {
            "src": "/icon-72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any maskable"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
